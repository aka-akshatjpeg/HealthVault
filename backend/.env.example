JWT_SECRET_KEY=replace-with-a-separate-random-value
DEMO_MODE=false
PUBLIC_BASE_URL=http://localhost:5000

# Firebase Authentication
FIREBASE_PROJECT_ID=healthvault-68880
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
