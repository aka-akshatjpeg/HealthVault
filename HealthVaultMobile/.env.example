# Copy this file to .env.local and restart Expo after changing the URL.
# Android emulator default:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Firebase public client settings
EXPO_PUBLIC_FIREBASE_PROJECT_ID=healthvault-68880
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_FIREBASE_APPLE_SERVICE_ID=your-apple-services-id
EXPO_PUBLIC_FIREBASE_APPLE_REDIRECT_URI=https://your-domain.example/auth/apple/redirect

# For a physical phone on the same Wi-Fi, use your computer's LAN address:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000

