# Copy this file to .env.local and restart Expo after changing the URL.
# Android emulator default:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# For a physical phone on the same Wi-Fi, use your computer's LAN address:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000

